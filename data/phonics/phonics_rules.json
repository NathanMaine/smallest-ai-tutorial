{
  "description": "Phonics rules covering silent-e, vowel teams, and consonant blends with training words",
  "silent_e_rule": {
    "description": "When a word ends in silent e, the preceding vowel is long (sounds like its letter name)",
    "words": {
      "make": [["m", "m"], ["a", "eɪ"], ["k", "k"], ["e", ""]],
      "bike": [["b", "b"], ["i", "aɪ"], ["k", "k"], ["e", ""]],
